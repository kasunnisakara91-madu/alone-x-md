# ===== ALONE-X-MD - .env =====
# මෙතන values පුරවන්න. මේ ෆයිල් එක කාටවත් share කරන්න එපා / GitHub එකට දාන්න එපා.

# --- Server ---
PORT=8000
# Bot deploy කරපු URL එක (menu/pair message වල පෙන්නන්න) e.g. https://your-app.com
BOT_URL=

# --- MongoDB (REQUIRED) ---
MONGO_URI=
MONGO_DB=MADUSHANKA_MD

# --- Bot owner numbers (comma separated, 94xxxxxxxxx) ---
OWNER_NUMBER=94743387798,94756331255

# --- API (ඔයාගේ API එකේ Base URL එකයි API Key එකයි) ---
# Base URL එක අගට / නැතුව, e.g. https://your-api-host
API_BASE_URL=
API_KEY=
